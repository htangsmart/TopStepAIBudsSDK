ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = YES
CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
FRAMEWORK_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BitByteData" "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON" "${PODS_CONFIGURATION_BUILD_DIR}/PromiseKit" "${PODS_CONFIGURATION_BUILD_DIR}/ReactiveObjC" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift" "${PODS_CONFIGURATION_BUILD_DIR}/SWCompression" "${PODS_CONFIGURATION_BUILD_DIR}/SocketRocket" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyJSON" "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary" "${PODS_CONFIGURATION_BUILD_DIR}/libopus" "${PODS_CONFIGURATION_BUILD_DIR}/zipzap" "${PODS_ROOT}/.." "${PODS_ROOT}/TopStepComKit-Git/TopStepComKit-Git/Classes/ComKit" "${PODS_ROOT}/TopStepComKit-Git/TopStepComKit-Git/Classes/FitCoreImp" "${PODS_ROOT}/TopStepComKit-Git/TopStepComKit-Git/Classes/Foundation" "${PODS_ROOT}/TopStepComKit-Git/TopStepComKit-Git/Classes/SJCoreImp" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TopStepAIBudsSDK" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TopStepComKit-Git/ComKit" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TopStepComKit-Git/FitCoreImp" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TopStepComKit-Git/Foundation" "${PODS_XCFRAMEWORKS_BUILD_DIR}/TopStepComKit-Git/SJCoreImp"
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
HEADER_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/BitByteData/BitByteData.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON/HandyJSON.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/PromiseKit/PromiseKit.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ReactiveObjC/ReactiveObjC.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa/RxCocoa.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxRelay/RxRelay.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/RxSwift/RxSwift.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SWCompression/SWCompression.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SocketRocket/SocketRocket.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/SwiftyJSON/SwiftyJSON.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/YYCategories/YYCategories.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation/ZIPFoundation.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary/iOSDFULibrary.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/libopus/libopus.framework/Headers" "${PODS_CONFIGURATION_BUILD_DIR}/zipzap/zipzap.framework/Headers" "${PODS_ROOT}/libopus/silk"
LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift
OTHER_LDFLAGS = $(inherited) -ObjC -l"c++" -l"icucore" -l"z" -framework "ABParTool" -framework "AVFoundation" -framework "AWEISIMG_SDK" -framework "Accelerate" -framework "AudioToolbox" -framework "BitByteData" -framework "CFNetwork" -framework "CoreAudio" -framework "CoreBluetooth" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CoreImage" -framework "CoreText" -framework "FitCloudDFUKit" -framework "FitCloudKit" -framework "FitCloudNWFKit" -framework "FitCloudWFKit" -framework "Foundation" -framework "HandyJSON" -framework "ImageIO" -framework "PromiseKit" -framework "QuartzCore" -framework "RTKLEFoundation" -framework "RTKLocalPlaybackSDK" -framework "RTKOTASDK" -framework "ReactiveObjC" -framework "RxCocoa" -framework "RxRelay" -framework "RxSwift" -framework "SJWatchLib" -framework "SWCompression" -framework "Security" -framework "SocketRocket" -framework "SwiftyJSON" -framework "TLOCP" -framework "TopStepABMateSDK" -framework "TopStepComKit" -framework "TopStepFitKit" -framework "TopStepInterfaceKit" -framework "TopStepSJWatchKit" -framework "TopStepToolKit" -framework "UIKit" -framework "UNIWatchMate" -framework "YYCategories" -framework "ZIPFoundation" -framework "h264encoder" -framework "iOSDFULibrary" -framework "libopus" -framework "opus-ios" -framework "zipzap"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/BitByteData" "-F${PODS_CONFIGURATION_BUILD_DIR}/HandyJSON" "-F${PODS_CONFIGURATION_BUILD_DIR}/PromiseKit" "-F${PODS_CONFIGURATION_BUILD_DIR}/ReactiveObjC" "-F${PODS_CONFIGURATION_BUILD_DIR}/RxCocoa" "-F${PODS_CONFIGURATION_BUILD_DIR}/RxRelay" "-F${PODS_CONFIGURATION_BUILD_DIR}/RxSwift" "-F${PODS_CONFIGURATION_BUILD_DIR}/SWCompression" "-F${PODS_CONFIGURATION_BUILD_DIR}/SocketRocket" "-F${PODS_CONFIGURATION_BUILD_DIR}/SwiftyJSON" "-F${PODS_CONFIGURATION_BUILD_DIR}/TopStepAIBudsSDK" "-F${PODS_CONFIGURATION_BUILD_DIR}/TopStepComKit-Git" "-F${PODS_CONFIGURATION_BUILD_DIR}/YYCategories" "-F${PODS_CONFIGURATION_BUILD_DIR}/ZIPFoundation" "-F${PODS_CONFIGURATION_BUILD_DIR}/iOSDFULibrary" "-F${PODS_CONFIGURATION_BUILD_DIR}/libopus" "-F${PODS_CONFIGURATION_BUILD_DIR}/zipzap"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
